  verify_rfc_value("[\"a\u{1a}b\"]", "[\"a\\u001ab\"]", false)
}

///|
test "RFC 8259 n n_rfc_control_1b" {
  verify_rfc_value("[\"a\u{1b}b\"]", "[\"a\\u001bb\"]", false)
}

///|
test "RFC 8259 n n_rfc_control_1c" {
  verify_rfc_value("[\"a\u{1c}b\"]", "[\"a\\u001cb\"]", false)
}

///|
test "RFC 8259 n n_rfc_control_1d" {
  verify_rfc_value("[\"a\u{1d}b\"]", "[\"a\\u001db\"]", false)
}

///|
test "RFC 8259 n n_rfc_control_1e" {
  verify_rfc_value("[\"a\u{1e}b\"]", "[\"a\\u001eb\"]", false)
}

///|
test "RFC 8259 n n_rfc_control_1f" {
  verify_rfc_value("[\"a\u{1f}b\"]", "[\"a\\u001fb\"]", false)
}

///|
test "RFC 8259 i i_rfc_unsafe_integer" {
  verify_rfc_value(
    "[9007199254740993,-9007199254740995]", "[9007199254740993,-9007199254740995]",
    true,
  )
}

///|
test "RFC 8259 i i_rfc_depth_limit" {
  guard @json_repair.repair(
      "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[0]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]",
    )
    is Err(error) else {
    fail("input selected for protective rejection was accepted")
  }
  assert_eq(error.kind.code(), "depth_limit")
}

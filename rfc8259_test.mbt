///|
// Generated by node tools/rfc-fixtures.mjs from the pinned corpus. See corpus/README.md.
fn verify_rfc_value(
  source : String,
  expected : String,
  no_edits : Bool,
) -> Unit raise {
  let report = @json_repair.repair(source).unwrap()
  assert_eq(report.json, expected)
  assert_eq(report.edits.is_empty(), no_edits)
  let strict = @json.parse(
    report.json[:],
    reject_duplicate_keys=true,
    preserve_number_repr=true,
  )
  assert_eq(strict.stringify(), report.value.stringify())
  let repeated = @json_repair.repair(report.json).unwrap()
  assert_eq(repeated.json, expected)
  assert_true(repeated.edits.is_empty())
}

///|
test "RFC 8259 i i_number_double_huge_neg_exp" {
  verify_rfc_value("[123.456e-789]", "[123.456e-789]", true)
}

///|
test "RFC 8259 i i_number_huge_exp" {
  verify_rfc_value(
    "[0.4e00669999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999969999999006]",
    "[0.4e00669999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999969999999006]",
    true,
  )
}

///|
test "RFC 8259 i i_number_neg_int_huge_exp" {
  verify_rfc_value("[-1e+9999]", "[-1e+9999]", true)
}

///|
test "RFC 8259 i i_number_pos_double_huge_exp" {
  verify_rfc_value("[1.5e+9999]", "[1.5e+9999]", true)
}

///|
test "RFC 8259 i i_number_real_neg_overflow" {
  verify_rfc_value("[-123123e100000]", "[-123123e100000]", true)
}

///|
test "RFC 8259 i i_number_real_pos_overflow" {
  verify_rfc_value("[123123e100000]", "[123123e100000]", true)
}

///|
test "RFC 8259 i i_number_real_underflow" {
  verify_rfc_value("[123e-10000000]", "[123e-10000000]", true)
}

///|
test "RFC 8259 i i_number_too_big_neg_int" {
  verify_rfc_value(
    "[-123123123123123123123123123123]", "[-123123123123123123123123123123]", true,
  )
}

///|
test "RFC 8259 i i_number_too_big_pos_int" {
  verify_rfc_value("[100000000000000000000]", "[100000000000000000000]", true)
}

///|
test "RFC 8259 i i_number_very_big_negative_int" {
  verify_rfc_value(
    "[-237462374673276894279832749832423479823246327846]", "[-237462374673276894279832749832423479823246327846]",
    true,
  )
}

///|
test "RFC 8259 i i_object_key_lone_2nd_surrogate" {
  verify_rfc_value("{\"\\uDFAA\":0}", "{\"\\\\uDFAA\":0}", false)
}

///|
test "RFC 8259 i i_string_1st_surrogate_but_2nd_missing" {
  verify_rfc_value("[\"\\uDADA\"]", "[\"\\\\uDADA\"]", false)
}

///|
test "RFC 8259 i i_string_1st_valid_surrogate_2nd_invalid" {
